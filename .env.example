# Frontend — copy to .env.local for development, set in Vercel/Netlify for production

# Medusa backend URL (no trailing slash)
REACT_APP_MEDUSA_URL=http://localhost:9000
FAST_REFRESH=false
GENERATE_SOURCEMAP=false
DISABLE_ESLINT_PLUGIN=true


# Publishable API key from Medusa Admin → Settings → Publishable API Keys
REACT_APP_MEDUSA_PUBLISHABLE_KEY=pk_your_key_here

# Region ID from Medusa Admin → Settings → Regions
REACT_APP_MEDUSA_REGION_ID=reg_your_region_id

# Bank transfer details (shown to customers at checkout)
REACT_APP_BANK_HOLDER=BUKUR WORLD
REACT_APP_BANK_IBAN=XK00 0000 0000 0000 0000
REACT_APP_BANK_NAME=Raiffeisen Bank Kosovo
REACT_APP_BANK_SWIFT=RBKOXKPR
