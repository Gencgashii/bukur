# ============================================================================
# BUKUR WORLD — Environment variable reference
# ============================================================================
# Copy this file and fill in real values. NEVER commit a filled-in file.
#
#   Local development:
#     - Frontend (Create React App):  cp .env.example .env
#     - Backend (Express API):        the same .env is read by server/ via dotenv
#
#   Production:
#     - Frontend: set REACT_APP_* vars in the static host (e.g. Vercel).
#     - Backend:  set the server vars in the API host (e.g. Render).
#
# WARNING: every REACT_APP_* value is embedded into the public JavaScript
# bundle at build time. Never put a password, DB URL, or private key here.
#
# Validate a production environment (never prints secrets):
#     npm run production:check -- --strict
# Full production checklist: docs/PRODUCTION-CHECKLIST.md
# ============================================================================


# ----------------------------------------------------------------------------
# FRONTEND (Create React App) — safe to expose, baked into the client bundle
# ----------------------------------------------------------------------------

# Base URL of the Express backend (NO trailing slash).
# Local:      http://localhost:9000
# Production: https://your-api-host.example.com
REACT_APP_API_URL=http://localhost:9000

# Bank-transfer details shown to customers at checkout (public information).
REACT_APP_BANK_HOLDER=BUKUR WORLD
REACT_APP_BANK_IBAN=XK00 0000 0000 0000 0000
REACT_APP_BANK_NAME=Raiffeisen Bank Kosovo
REACT_APP_BANK_SWIFT=RBKOXKPR


# ----------------------------------------------------------------------------
# FRONTEND BUILD FLAGS (Create React App) — optional
# ----------------------------------------------------------------------------

# Disable source maps in the production build (smaller output, no code exposure).
GENERATE_SOURCEMAP=false

# Skip the ESLint plugin during `npm run build` (build stays green on warnings).
DISABLE_ESLINT_PLUGIN=true

# Disable React Fast Refresh in development if it causes reload loops.
FAST_REFRESH=false


# ----------------------------------------------------------------------------
# BACKEND (server/ — Express + PostgreSQL) — SECRET, backend host only
# ----------------------------------------------------------------------------

# Port the Express API listens on. Hosts like Render inject their own PORT.
PORT=9000

# --- Database connection -----------------------------------------------------
# Option A (preferred in production): a single connection string.
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Option B (used only when DATABASE_URL is empty): discrete fields.
# Handy locally when the password contains URL-unsafe characters.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bukur
DB_USER=postgres
DB_PASSWORD=

# TLS for the database connection. Leave blank for local Postgres.
#   true   -> require TLS, do not verify the server certificate (most managed PG)
#   strict -> require TLS and verify the certificate
DATABASE_SSL=

# --- Auth ------------------------------------------------------------------
# Secret used to sign admin JWTs. REQUIRED in every environment — the server
# refuses to start without it (no insecure fallback). Must be >= 32 chars in
# production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin token lifetime.
JWT_EXPIRES_IN=12h

# Admin session cookie SameSite policy: lax | strict | none.
#   lax    (default) works when the admin dashboard and this API share a
#          registrable domain (localhost:3000 <-> localhost:9000 counts).
#   none   REQUIRED when the admin dashboard is on a different domain than the
#          API (e.g. dashboard on Vercel, API on Render). Forces Secure cookies;
#          CSRF is then covered by the double-submit token + CORS allowlist.
ADMIN_COOKIE_SAMESITE=lax

# Set to "true" ONLY for the one-off first admin bootstrap, then remove it.
# Leave unset/blank in normal operation.
ALLOW_ADMIN_REGISTER=

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed browser origins (no trailing slash).
# Local dev default is http://localhost:3000. REQUIRED in production.
CLIENT_ORIGINS=http://localhost:3000

# --- Pricing / shipping (server is authoritative) ------------------------
# Shipping rates in CENTS, keyed by ISO-2 country code. "XK:180,AL:480".
SHIPPING_RATES=XK:180,AL:480

# Tax rate in BASIS POINTS (100 = 1.00%). 0 = no tax (current behaviour).
# Do NOT invent a VAT rate — set this only once the business confirms it.
TAX_RATE_BPS=0

CURRENCY=eur

# Offer cash on delivery at checkout?
ENABLE_COD=true

# --- Payments (Phase 2A — architecture only) -----------------------------
# Which implementation handles online card payments: "teb" (real, currently a
# blocked stub) or "mock" (dev/test only, never allowed in production).
PAYMENTS_CARD_PROVIDER=teb

# Mock provider (development/testing only; forced off when NODE_ENV=production).
PAYMENTS_ALLOW_MOCK=true
PAYMENTS_MOCK_SECRET=change-me-in-dev

# --- Media storage (ADMIN-uploaded product images only) ----------------
# Storefront hero/campaign/editorial photography is a separate build-time
# pipeline (media-src/ -> `npm run media:optimize` -> public/media/, served as
# static AVIF/WebP/JPEG) and does NOT use this storage layer.
#
#   local  (default) — writes admin uploads to public/uploads, served by the
#          API. Fine for development. Render's disk is EPHEMERAL, so this is
#          NOT durable in production (uploads vanish on redeploy/restart).
#   s3     — any S3-compatible object store (AWS S3, Cloudflare R2, MinIO,
#          Backblaze B2, ...). Use this in production. FAILS CLOSED: if
#          STORAGE_DRIVER=s3 and any required S3_* var below is missing, the
#          API refuses to boot (it never silently falls back to local).
STORAGE_DRIVER=local

# Optional for the LOCAL driver: absolute base URL prepended to /uploads paths
# (e.g. the API's own public origin). Blank = return root-relative /uploads/...
MEDIA_PUBLIC_BASE_URL=

# --- S3-compatible object storage (required only when STORAGE_DRIVER=s3) ---
# SECRETS: never commit real values. Set these in the API host (Render) only.
# REQUIRED for s3:
#   S3_BUCKET=                 bucket name, e.g. bukur-media
#   S3_REGION=                 AWS region, e.g. eu-central-1  (Cloudflare R2: auto)
#   S3_ACCESS_KEY_ID=          access key id            (SECRET)
#   S3_SECRET_ACCESS_KEY=      secret access key        (SECRET)
#   S3_PUBLIC_BASE_URL=        public read base for stored objects, no trailing
#                              slash, e.g. https://img.bukurworld.com  or
#                              https://<bucket>.s3.<region>.amazonaws.com
#                              (final URL = S3_PUBLIC_BASE_URL/products/<uuid>.<ext>)
# OPTIONAL for s3:
#   S3_ENDPOINT=               custom API endpoint for non-AWS providers, e.g.
#                              https://<accountid>.r2.cloudflarestorage.com
#                              Omit for AWS S3 (endpoint is derived from region).
#   S3_FORCE_PATH_STYLE=       "true" | "false". Default: true when S3_ENDPOINT
#                              is set (R2/MinIO), false for AWS S3.
# Minimum IAM/bucket permissions the app needs: s3:PutObject and s3:DeleteObject
# on arn:aws:s3:::<bucket>/products/*  — no ListBucket, no admin rights.

# --- Transactional email (order confirmations) -------------------------
# Sent server-side only. No credential is ever exposed to the browser.
#
#   EMAIL_ENABLED   'true' to actually send. Default 'false' (safe for local
#                   dev / CI: orders still succeed, status is recorded 'skipped').
#   EMAIL_PROVIDER  'console' (dev: logs + writes .mail-preview/*.html, NEVER sends)
#                   'memory'  (automated tests only)
#                   'resend'  (PRODUCTION: Resend HTTP API — needs RESEND_API_KEY)
#                   In production, 'console' / 'memory' are rejected at boot.
#   EMAIL_FROM      REQUIRED when EMAIL_ENABLED=true. RFC form, e.g.
#                   "BUKUR WORLD <orders@your-verified-domain.com>"
#                   (do not invent a real address here — set it in the host)
#   EMAIL_REPLY_TO  optional Reply-To, e.g. support@your-domain.com
#   EMAIL_STORE_URL optional absolute https base for links in the email
EMAIL_ENABLED=false
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_STORE_URL=
# Provider secret — set ONLY in the API host, never commit a real value:
#   RESEND_API_KEY=            (required when EMAIL_PROVIDER=resend)
# Resend also requires the EMAIL_FROM domain to be verified in the Resend
# dashboard (SPF/DKIM) before it will deliver.

# --- TEB Kosovo e-commerce gateway --------------------------------------
# PLACEHOLDERS ONLY. The real variable names / formats are UNKNOWN until
# official TEB merchant integration documentation is provided. Do NOT put
# real credentials here. Do NOT assume TEB uses exactly these names.
#   TEB_API_URL=
#   TEB_MERCHANT_ID=
#   TEB_TERMINAL_ID=
#   TEB_SECRET=
#   TEB_RETURN_URL=
#   TEB_CALLBACK_URL=


# ----------------------------------------------------------------------------
# my-medusa-store/ — NOT the active storefront backend (see README).
# Kept for reference only. Its own vars (STORE_CORS, RESEND_API_KEY, ...) are
# documented in that folder and are not required to run BUKUR WORLD today.
# ----------------------------------------------------------------------------
